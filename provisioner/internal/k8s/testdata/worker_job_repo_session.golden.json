              },
              {
                "name": "no_proxy",
                "value": "127.0.0.1,localhost,.cluster.local,.svc,.bnei.lan,.bnei.dev,bnei.dev,10.233.0.0/18,10.233.64.0/18,192.168.1.0/24"
              },
