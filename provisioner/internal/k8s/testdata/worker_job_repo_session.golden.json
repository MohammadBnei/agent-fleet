              },
              {
                "name": "MAX_MCP_OUTPUT_TOKENS",
                "value": "10000"
              }
            ],
            "resources": {
              "limits": {
                "cpu": "4",
                "memory": "4Gi"
              },
              "requests": {
                "cpu": "100m",
                "memory": "1Gi"
              }
            },
            "volumeMounts": [
              {
                "name": "session",
                "mountPath": "/workspace",
                "subPath": "tree"
              },
              {
                "name": "session",
                "mountPath": "/cache",
                "subPath": "cache"
              },
              {
                "name": "shared",
                "readOnly": true,
                "mountPath": "/repo-cache",
                "subPath": "repos"
              },
              {
                "name": "shared",
                "mountPath": "/claude-home",
                "subPath": "claude-home/task-1"
              },
              {
                "name": "shared",
