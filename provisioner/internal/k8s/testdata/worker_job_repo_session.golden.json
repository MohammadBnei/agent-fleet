{
  "metadata": {
    "name": "worker-task1",
    "namespace": "agent-fleet",
    "labels": {
      "agent-fleet.dev/component": "worker",
      "agent-fleet.dev/repo": "dream-analyst",
      "agent-fleet.dev/task-id": "task-1",
      "app.kubernetes.io/part-of": "agent-fleet",
      "fleet.bnei.dev/vault-owner": "owner-o"
    },
    "annotations": {
      "fleet.bnei.dev/vault-label": "task-1.1"
    }
  },
  "spec": {
    "activeDeadlineSeconds": 43200,
    "backoffLimit": 0,
    "template": {
      "metadata": {
        "labels": {
          "agent-fleet.dev/component": "worker",
          "agent-fleet.dev/repo": "dream-analyst",
          "agent-fleet.dev/task-id": "task-1",
          "app.kubernetes.io/part-of": "agent-fleet",
          "fleet.bnei.dev/vault-owner": "owner-o"
        }
      },
      "spec": {
        "volumes": [
          {
            "name": "session",
            "persistentVolumeClaim": {
              "claimName": "session-task1"
            }
          },
          {
            "name": "shared",
            "persistentVolumeClaim": {
              "claimName": "agent-fleet-workspace"
            }
          },
          {
            "name": "agent-vault-ca",
            "configMap": {
              "name": "agent-vault-ca"
            }
          }
        ],
        "initContainers": [
          {
            "name": "clone",
            "image": "registry.bnei.lan:5000/agent-fleet-worker:latest",
            "command": [
              "sh",
              "-c",
              "set -eu\n# Git's ownership guard (CVE-2022-24765) refuses every command in a repository\n# whose directory belongs to another user. The PVC's mount point is created by\n# the kubelet as root and this container runs as the image's non-root user, so\n# without this the clone SUCCEEDS and the very next command fails with\n# \"detected dubious ownership\" — which is what happened the first time this\n# ran in kind. worker/src/index.ts already carries the same line for the same\n# reason; both containers need it because they do not share $HOME.\n#\n# The wildcard, not the two paths this used to list, because safe.directory is\n# an exact compare against the path git NAMES — and a local-transport clone\n# enters the cache as a bare gitdir, so the path it wants is\n# /repo-cache/\u003crepo\u003e/.git, not the directory above it. Listing the parent\n# looked right, matched nothing, and every session died on \"Could not read from\n# remote repository\" — the clone's report of a failure that was really the\n# ownership guard. The sidecar container next door already wildcards the same\n# way (pod.go's GIT_CONFIG_VALUE_0). This container runs as uid 1000 and\n# mounts only its own workspace plus the read-only cache; there is nothing else\n# here for a wildcard to over-trust.\ngit config --global --add safe.directory '*'\n\n# A finished clone has the marker (the script's last step) or, if it is a\n# repo session's tree from before the marker existed, an index (that clone\n# checked out in one step). Either way the agent may have worked there: keep\n# it. Anything else is a clone killed mid-way (OOM, eviction, a missing base\n# branch; no trap would run), which the agent never ran on, since the worker\n# starts only after this container succeeds: wipe it and clone again. A\n# --no-checkout clone writes no index until the checkout below.\nif [ -f /workspace/.git/fleet-clone-done ] || [ -f /workspace/.git/index ]; then\n  echo \"workspace already has a repository, leaving it alone\"\n  exit 0\nfi\nmkdir -p /workspace\nfind /workspace -mindepth 1 -delete\ngit clone --shared --no-checkout /repo-cache/dream-analyst /workspace\ncd /workspace\n# docs/adr/0064: local transport only. This container holds no credential and\n# never contacts the remote: the fetch names the cache's PATH, not \"origin\", so\n# no reordering can turn it into a remote fetch. It copies the cache's\n# REMOTE-TRACKING refs, which the provisioner fetched with its own credentials\n# (git.Manager.EnsureRepoFetched, never skipped) just before this pod was\n# created, over the ones clone --shared made from the cache's local branches\n# (frozen at its first clone), so origin/* is current.\ngit fetch --no-tags /repo-cache/dream-analyst '+refs/remotes/origin/*:refs/remotes/origin/*'\n# Before the checkout: the index it writes is what keeps this tree, so the\n# remote must already be the real one by then.\ngit remote set-url origin https://github.com/o/dream-analyst.git\ngit checkout -B dev origin/dev\ntouch .git/fleet-clone-done\n"
            ],
            "resources": {
              "limits": {
                "cpu": "1",
                "memory": "1Gi"
              },
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "session",
                "mountPath": "/workspace",
                "subPath": "tree"
              },
              {
                "name": "shared",
                "readOnly": true,
                "mountPath": "/repo-cache",
                "subPath": "repos"
              }
            ]
          },
          {
            "name": "sidecar",
            "image": "registry.bnei.lan:5000/agent-fleet-sidecar:latest",
            "ports": [
              {
                "name": "health",
                "containerPort": 9092
              }
            ],
            "env": [
              {
                "name": "SESSION_ID",
                "value": "task-1"
              },
              {
                "name": "TARGET_REPO",
                "value": "dream-analyst"
              },
              {
                "name": "MCP_PORT",
                "value": "9090"
              },
              {
                "name": "LOCAL_API_PORT",
                "value": "9091"
              },
              {
                "name": "HEALTH_PORT",
                "value": "9092"
              },
              {
                "name": "LEASE_ID",
                "value": "lease-1"
              },
              {
                "name": "WORKTREE_PATH",
                "value": "/workspace"
              },
              {
                "name": "LOG_LEVEL"
              },
              {
                "name": "CORE_GRPC_ADDR"
              },
              {
                "name": "GIT_CONFIG_COUNT",
                "value": "1"
              },
              {
                "name": "GIT_CONFIG_KEY_0",
                "value": "safe.directory"
              },
              {
                "name": "GIT_CONFIG_VALUE_0",
                "value": "*"
              },
              {
                "name": "FLEET_VAULT_PROXY",
                "value": "http://tok:owner-o@agent-vault.agent-vault.svc.cluster.local:14322"
              },
              {
                "name": "FLEET_VAULT_HOSTS",
                "value": "api.anthropic.com,github.com,api.github.com"
              },
              {
                "name": "EGRESS_PORT",
                "value": "9093"
              }
            ],
            "resources": {
              "limits": {
                "cpu": "250m",
                "memory": "256Mi"
              },
              "requests": {
                "cpu": "50m",
                "memory": "64Mi"
              }
            },
            "restartPolicy": "Always",
            "volumeMounts": [
              {
                "name": "session",
                "mountPath": "/workspace",
                "subPath": "tree"
              },
              {
                "name": "shared",
                "readOnly": true,
                "mountPath": "/repo-cache",
                "subPath": "repos"
              }
            ],
            "startupProbe": {
              "httpGet": {
                "path": "/readyz",
                "port": 9092
              },
              "periodSeconds": 2,
              "failureThreshold": 60
            }
          }
        ],
        "containers": [
          {
            "name": "worker",
            "image": "registry.bnei.lan:5000/agent-fleet-worker:latest",
            "env": [
              {
                "name": "SESSION_ID",
                "value": "task-1"
              },
              {
                "name": "TARGET_REPO",
                "value": "dream-analyst"
              },
              {
