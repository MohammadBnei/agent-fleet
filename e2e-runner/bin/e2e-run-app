#!/usr/bin/env bash
# Start the target app once, detached, in its own process group.
#
# Extracted from entrypoint.sh so that starting the app is one command with
# one definition, callable from three places: the entrypoint at boot, the
# dashboard's "Restart app" button, and the agent's own run_command. Before
# this, "restart the app" meant each caller hand-composing a shell line that
# had to re-derive the worktree, the port and the redirection — and get the
# process-group handling right, which is the part that actually matters.
#
# Deliberately does NOT restart on failure (docs/adr/0044): the app runs once,
# its exit status is logged, and the pod stays up. Use e2e-restart-app to run
# it again after fixing the cause.
set -uo pipefail

: "${E2E_WORKTREE_PATH:?E2E_WORKTREE_PATH is required}"
: "${E2E_APP_PORT:?E2E_APP_PORT is required}"
E2E_START_CMD="${E2E_START_CMD:-}"

APP_LOG=${E2E_APP_LOG:-/tmp/e2e-app.log}
APP_PGID_FILE=${E2E_APP_PGID_FILE:-/tmp/e2e-app.pgid}

if [ -z "${E2E_START_CMD}" ]; then
	echo "e2e-run-app: no E2E_START_CMD — this is a sandbox-only pod, there is no app to start." >>"${APP_LOG}"
	exit 0
fi

# setsid gives the app its own process group, which is the whole point: a dev
# server spawns children (esbuild, tsc --watch, a bundler), and killing only
# the shell we launched would orphan them still holding $PORT — so the next
# start fails with EADDRINUSE and the restart looks like it silently did
# nothing. e2e-restart-app signals the group, so the whole tree goes.
#
# Output goes to the log file only; entrypoint.sh tails that file to the
# container's stdout, so Loki still sees everything (view_logs component=e2e)
# without this script needing to know it isn't PID 1's child.
{
	echo "--- starting app: ${E2E_START_CMD} ---"
} >>"${APP_LOG}"

setsid bash -c '
	cd "${E2E_WORKTREE_PATH}" || exit 127
	PORT="${E2E_APP_PORT}" bash -lc "${E2E_START_CMD}"
	echo "--- e2e app command exited with status $? ---"
	echo "--- the sandbox stays up; fix the cause, then restart with e2e-restart-app ---"
' >>"${APP_LOG}" 2>&1 &

# $! is the setsid child, which is its own group leader, so its PID is the
# PGID. Recorded rather than re-derived with pgrep: matching on the command
# string would also match the agent's own `grep`, and worse, any test process
# running the same dev-server binary.
echo "$!" >"${APP_PGID_FILE}"
echo "e2e-run-app: started (pgid $(cat "${APP_PGID_FILE}")), logging to ${APP_LOG}"
