node_modules/
dist/
# Exception: fleet-core/internal/webui/dist/ needs a tracked placeholder —
# go:embed all:dist fails on a truly empty/nonexistent directory, and a
# fresh CI checkout has no built SPA output sitting there yet.
!fleet-core/internal/webui/dist/
!fleet-core/internal/webui/dist/.gitkeep

# local/kind testing ground: Mac-side view of the kind node's hostPath mount
# (worktrees/clones from real local test runs) — never committed.
local/kind/workspace-data/

# Stray output of building e2e-runner/cmd/execmcp from the repo root
# instead of its own module directory.
/execmcp

# Subagent git worktrees (Agent tool isolation) — never part of the repo
.claude/worktrees/

# Playwright MCP scratch output (screenshots, snapshots, console logs)
.playwright-mcp/
