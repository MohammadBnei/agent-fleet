{
  "name": "agent-fleet",
  "version": "4.14.8",
  "private": true,
  "scripts": {
    "release": "release-it"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.2",
    "release-it": "^21.1.0"
  },
  "release-it": {
    "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
    "git": {
      "commitMessage": "chore: release v${version}",
      "pushArgs": [
        "--follow-tags",
        "--atomic"
      ]
    },
    "github": {
      "release": false
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        },
        "infile": "CHANGELOG.md"
      }
    }
  }
}
